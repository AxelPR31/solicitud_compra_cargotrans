<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS: proxy inverso para el módulo Solicitud de Compra.

  Requisitos en el servidor:
  - IIS + URL Rewrite Module 2.x
  - Application Request Routing (ARR) con "Enable proxy" activado
  - Node: Next.js en http://127.0.0.1:3000 (npm run start)
  - Node: API Nest en http://127.0.0.1:7500 (npm run start:prod)

  Sitio IIS: binding HTTPS (ej. https://compras.empresa.com)
  Colocar este web.config en la raíz física del sitio (o carpeta virtual).

  Ajustar BACKEND_URL y FRONTEND_URL si usan otros puertos/host.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Rutas del API Nest (mismo path que en el backend, sin prefijo /api) -->
        <rule name="CS_ERP_ReverseProxy_API" stopProcessing="true">
          <match url="^(auth|solicitud-oc|globales-co|departamento|centrocosto|centro-cuenta|cuentacontable|articulo|articulo-cuenta|usuario-softland|tenant|docs)(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:7500/{R:0}" appendQueryString="true" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
          </serverVariables>
        </rule>

        <!-- Todo lo demás → Next.js -->
        <rule name="CS_ERP_ReverseProxy_Next" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" appendQueryString="true" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
          </serverVariables>
        </rule>
      </rules>
      <outboundRules>
        <rule name="CS_ERP_Preserve_Set_Cookie" preCondition="ResponseIsSetCookie">
          <match serverVariable="RESPONSE_Set_Cookie" pattern=".*" />
          <action type="Rewrite" value="{R:0}" />
        </rule>
        <preConditions>
          <preCondition name="ResponseIsSetCookie">
            <add input="{RESPONSE_Set_Cookie}" pattern="." />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
