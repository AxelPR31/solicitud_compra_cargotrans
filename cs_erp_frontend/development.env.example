# Opcional. Si no existe .env.local, el front usa /backend (proxy a :7500).
# Copiar solo si necesitas otro valor:
#   cp development.env.example .env.local
#
# Abrir: http://localhost:3000 (no https)
# Nest en otra terminal: cs_erp_server (puerto 7500)
#
# No uses http://localhost:7500 aquí: la cookie de login no se comparte con :3000.
# NEXT_PUBLIC_BACKEND_API_URL=/backend
